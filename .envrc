# Shared cargo target dir so multiple git worktrees reuse ONE build — Bevy is
# compiled once across all worktrees, making a 2nd worktree's build ~9x cheaper
# (GTW-382). $HOME expands per-machine; CI never runs direnv, so CI is unaffected.
#
# One-time per machine to activate:
#   1. add the direnv hook to your shell rc:   eval "$(direnv hook zsh)"
#   2. trust this file (in each checkout/worktree):   direnv allow
export CARGO_TARGET_DIR="$HOME/.cache/gdtf-target"

# Pin the battle seed for reproducible runs (GTW-14: per-subsystem RNG streams).
# Unset = wall-clock fallback (different seed every run — the non-deterministic default).
# Example: export GDTF_BATTLE_SEED=42   (use the same value from the info! log to reproduce)
# export GDTF_BATTLE_SEED=
