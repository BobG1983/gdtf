// fixture terrain def — a registry-PRESENT def whose four `Facing` view rows all name a
// sprite def this root never defines. The root DOES ship sprite defs under
// content/sprites/, and `ghost_graphic` is deliberately not among them, so the terrain
// view→sprite-def edge dangles ON PURPOSE on every row (NOT shipped content; loaded only by
// tests/authoring_validation/ — the editor-side authoring-time validation pins). Structural
// magnitudes are arbitrary schema-valid values.
(
    key: "00000000-0000-0000-0000-0663000000a1",  // this def IS in the registry
    display_name: "Ghost Tile",
    sim_kind: Cover(
        hp:               10,   // arbitrary schema-valid structural stats
        armor_protection: 0,
        armor_hardness:   0,
        height_band:      Low,
    ),
    presenter_kind: Cover,
    // DANGLING sprite-def key on every row — no ghost_graphic.spritedef.ron
    views: [
        (view: Facing(North), sprite: "ghost_graphic"),
        (view: Facing(East), sprite: "ghost_graphic"),
        (view: Facing(South), sprite: "ghost_graphic"),
        (view: Facing(West), sprite: "ghost_graphic"),
    ],
    tags: [],
)
