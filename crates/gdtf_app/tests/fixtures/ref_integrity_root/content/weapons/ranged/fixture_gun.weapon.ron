// fixture weapon — a schema-valid ranged weapon whose `attachments` list names a
// key the (deliberately un-materialized) attachments folder cannot resolve, so the
// weapons→attachments edge dangles ON PURPOSE (NOT shipped content; loaded only by
// tests/load_ref_integrity.rs). Stats are arbitrary schema-valid values — never asserted.
(
    base_spread:   0.10,
    accuracy:      1.0,
    kickback:      0.05,
    fatal_bias:    0.0,
    damage:        6,
    punch:         2,
    shred:         1,
    damage_type:   Kinetic,
    magazine: (
        size:      12,
        reload_tu: 12,
    ),
    fire_mode: [
        (kind: Single, cone_mult: 1.0, tu_percent: 0.30, shots: 1),
    ],
    stable: false,
    handedness:    OneHanded,
    slots: [
        (Sight, 1),  // a sight dovetail — the dangling item WOULD fit here if it existed
    ],
    attachments:   ["ghost_scope"],  // DANGLING attachment key — no ghost_scope.attachment.ron
    // DANGLING field key — the fields folder is not materialized in this root, so the
    // weapon on-death → field-def edge dangles too.
    on_death: [
        LeaveField(field: "ghost_gun_field"),
    ],
)
