// GDTF grimdark UI theme — data-driven, nested per-widget sub-themes.
// Colors are RGBA 0.0–1.0. Lengths relative (Vw/Vh) to 1280x720 reference.
#![enable(implicit_some)]
(
    default_font: "fonts/Alegreya-Variable.ttf",

    background: (
        color: (0.05, 0.05, 0.06, 1.0),
    ),

    panel: (
        color:            (0.12, 0.12, 0.15, 0.55),
        border_color:     (0.20, 0.20, 0.24, 1.0),
        border_width:     0.15625,
        corner_radius:    0.390625,
        margin: ( left: 0.9375, right: 0.9375, top: 0.83333, bottom: 0.83333 ),
    ),

    button: (
        color:    (0.16, 0.16, 0.18, 0.96),
        disabled: (0.08, 0.08, 0.10, 0.55),
        active:   (0.45, 0.62, 0.30, 0.96),
        hover:    (0.80, 0.16, 0.19, 0.96),
        pressed:  (0.10, 0.10, 0.12, 0.96),
        text_color:       (0.84, 0.80, 0.73, 1.0),
        font_size_pt:     18.0,
        border_color:     (0.20, 0.20, 0.24, 1.0),
        border_width:     0.15625,
        corner_radius:    0.390625,
        margin: ( left: 0.9375, right: 0.9375, top: 0.83333, bottom: 0.83333 ),
    ),

    title: (
        text_color:   (0.84, 0.80, 0.73, 1.0),
        font_size_pt: 36.0,
        font: "fonts/Cinzel-Variable.ttf",
    ),

    text: (
        text_color:   (0.84, 0.80, 0.73, 1.0),
        font_size_pt: 18.0,
    ),
)
