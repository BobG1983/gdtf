// hazard_suit — sealed chem/bio coveralls that wrap the limbs as fully as the
// core. Baseline protection, even all over, nowhere left bare — the suit that
// covers what others leave exposed.
(
    head:      (floor: 1, protection: 6, integrity: 50, hardness: 3, armor_type: Hazard),
    torso:     (floor: 1, protection: 8, integrity: 60, hardness: 3, armor_type: Hazard),  // most hits land here
    left_arm:  (floor: 0, protection: 4, integrity: 45, hardness: 2, armor_type: Hazard),
    right_arm: (floor: 0, protection: 4, integrity: 45, hardness: 2, armor_type: Hazard),
    left_leg:  (floor: 0, protection: 5, integrity: 50, hardness: 2, armor_type: Hazard),
    right_leg: (floor: 0, protection: 5, integrity: 50, hardness: 2, armor_type: Hazard),
)
