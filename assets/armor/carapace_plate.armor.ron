// carapace_plate — the heaviest shell on the wheel. Rigid plate turns more punch
// aside than any other suit; the trade is bulk and a body that slows you down.
// Top protection, baseline endurance — it stops the hit hard, and the head and core
// plates seal so tight that nothing slips past unblunted.
(
    head:      (floor: 1, protection: 8,  integrity: 55, hardness: 4, armor_type: Plated),
    torso:     (floor: 1, protection: 10, integrity: 65, hardness: 4, armor_type: Plated),  // top protection on the wheel — plate turns the hit
    left_arm:  (floor: 0, protection: 6,  integrity: 50, hardness: 3, armor_type: Plated),
    right_arm: (floor: 0, protection: 6,  integrity: 50, hardness: 3, armor_type: Plated),
    left_leg:  (floor: 0, protection: 7,  integrity: 55, hardness: 3, armor_type: Plated),
    right_leg: (floor: 0, protection: 7,  integrity: 55, hardness: 3, armor_type: Plated),
)
