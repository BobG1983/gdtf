// refractor_field — a shimmer, not a shell. The field-thin harness bleeds off
// glancing energy on a harder edge than any suit but ceramic, yet offers little body —
// it shrugs the graze and tears under the rest. Lowest integrity on the wheel bar ceramic.
(
    head:      (floor: 1, protection: 6, integrity: 45, hardness: 4, armor_type: Refractive),  // raised hardness — the field disperses the worst edge
    torso:     (floor: 1, protection: 8, integrity: 55, hardness: 4, armor_type: Refractive),
    left_arm:  (floor: 0, protection: 4, integrity: 40, hardness: 3, armor_type: Refractive),
    right_arm: (floor: 0, protection: 4, integrity: 40, hardness: 3, armor_type: Refractive),
    left_leg:  (floor: 0, protection: 5, integrity: 45, hardness: 3, armor_type: Refractive),
    right_leg: (floor: 0, protection: 5, integrity: 45, hardness: 3, armor_type: Refractive),
)
