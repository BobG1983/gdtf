// GTW-437 SAMPLE weighting for the LeftLeg; GTW-444 references the "Hampered" knee injury
// so it can be rolled on a Major left-leg wound. The full >=6-entries-per-severity content
// floor is GTW-440 — empty buckets are valid (they build no table; the GTW-438 roll then
// finds no table and inflicts no injury). `injury:` is an InjuryName KEY (the `.injury.ron`
// file stem); an unknown key WARNs + is skipped at table-build. Authored order does NOT
// affect determinism (entries are canonically sorted at build).
(
    body_part: LeftLeg,                                        // the part this table weights
    minor:    [],                                              // Minor bucket    (GTW-440 fills the floor)
    major:    [ (injury: "shattered_left_knee", weight: 6) ],  // GTW-444 Hampered (slower movement) + -1 Speed
    critical: [],                                              // Critical bucket (GTW-440 fills the floor)
)
