// GTW-443 hand-disabling arm injury (RIGHT). A Major wound that wrecks the right hand:
// the ganger keeps one-handed weapons but can no longer brace a two-handed long-arm,
// and its aim suffers while the hand is ruined. The DisableHand effect is keyed to this
// file's body_part (RightArm -> the right hand); the Modify(Shooting, -N) carries the
// always-on 1H aim penalty through the normal modifier layer (GTW-443 F3).
// KEY = file stem minus `.injury` => `shattered_right_hand`.
(
    name:         "Shattered Right Hand",           // display InjuryName (inspect-panel label)
    body_part:    RightArm,                         // authoritative; maps DisableHand -> the right hand
    severity:     Major,                            // Minor | Major | Critical (None/Fatal never tabled)
    popup_text:   "RIGHT HAND SHATTERED",           // -> floating combat text (FCT)
    log_text:     "shatters a hand",                // -> combat log line ("<name> shatters a hand")
    inspect_text: "Shattered Right Hand -- no two-handed weapons, -2 Shooting", // -> inspect panel
    effects: [
        DisableHand,                                // GTW-443: disables the RIGHT hand (fieldless; side from body_part)
        Modify(stat: Shooting, amount: -2),         // GTW-443 F3: always-on 1H aim penalty (N tunable per injury)
    ],
    // post_heal omitted -> defaults to Deferred (GTW-23 Healing owns the semantics).
)
