// Battle keybinds. This file overrides `Keybinds::default()` on load; a test keeps the two equal.
(
    select_clear: KeyEscape,    // clear the current ganger selection
    level_up:     KeyPageUp,    // raise the active storey by one level (clamped to the top)
    level_down:   KeyPageDown,  // lower the active storey by one level (floored at 0)
    toggle_full_view: KeyV,     // toggle FullView (draw ALL storeys) vs DownToActive (0..=active)
    stance_cycle: KeyC,         // step the selected ganger's stance (Standing->Crouching->Prone->wrap)
    aim_toggle:   KeyF,         // toggle the selected ganger's aim mode
    facing_cycle: KeyR,         // step the selected ganger's facing (N->NE->...->NW->wrap)
    select_next:  KeyTab,       // cycle selection to the next player ganger in (z,y,x) order
    select_prev:  KeyTab,       // same key as select_next; Shift picks this one
)
