// EW-orientation companion of stair_ns_up. Same sim semantics (sim_kind = Slab);
// only difference is presenter_kind.graphic_name = "stair_ew_up" (NS sprite rotated 90deg).
// Orientation is presentation-only — author places the correct orientation in a prefab.
(
    // Stable authored key — industrial_hive EW ascending-stair TerrainUuid.
    key: "00000000-0000-0000-0000-01840a91000f",
    display_name: "Deck Stair Up (EW)",
    sim_kind: Slab(
        hp:               120,   // structural HP (copied from the NS ascending stair)
        armor_protection: 4,     // damage soak (copied)
        armor_hardness:   2,     // punch ignored (copied)
    ),
    presenter_kind: Slab(
        graphic_name: "stair_ew_up", // EW ascending-stair sprite — NS up rotated 90deg
        footfall:     None,          // no authored footfall
    ),
    views: [
        (view: FromBelow(North), sprite: "stair_ew_up"),
        (view: FromAbove(North), sprite: "stair_ew_up"),
        (view: FromBelow(East), sprite: "stair_ew_up"),
        (view: FromAbove(East), sprite: "stair_ew_up"),
        (view: FromBelow(South), sprite: "stair_ew_up"),
        (view: FromAbove(South), sprite: "stair_ew_up"),
        (view: FromBelow(West), sprite: "stair_ew_up"),
        (view: FromAbove(West), sprite: "stair_ew_up"),
    ],
    tags: [Stair],
)
