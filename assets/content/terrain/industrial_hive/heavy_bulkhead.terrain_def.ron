// GTW-490 migration of assets/content/terrain/heavy_bulkhead.terrain.ron to the NEW
// UUID-keyed per-theme TerrainDef model (GTW-484/487). Magnitudes COPIED verbatim from the
// flat file. presenter_kind.graphic_name = the flat file's `graphic` TileRoles key ("wall");
// the old atlas index is INTENTIONALLY DROPPED. A solid wall blocks vision + pathfinding —
// authored sim-side via the BlocksVision / BlocksPathfinding tags (consumption is GTW-482).
(
    // Stable authored key — the industrial_hive `heavy_bulkhead` TerrainUuid.
    key: "00000000-0000-0000-0000-01840a910007",
    display_name: "Heavy Bulkhead",
    sim_kind: Wall(
        hp:               120,   // structural HP (copied)
        armor_protection: 8,     // damage-reduction stat (copied)
        armor_hardness:   4,     // penetration shrugged off (copied)
        height_band:      High,  // a tall wall; nothing flies strictly over it within a storey
    ),
    presenter_kind: Wall(
        graphic_name: "wall",    // flat file's `graphic` TileRoles key
    ),
    // SIM-OWNED tags: a heavy wall blocks both line-of-sight and pathfinding.
    tags: [BlocksVision, BlocksPathfinding],
)
