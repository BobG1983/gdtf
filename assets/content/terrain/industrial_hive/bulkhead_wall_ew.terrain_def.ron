// EW-orientation companion of bulkhead_wall. Same sim semantics (Wall);
// only difference is graphic_name = "wall_ew". Orientation is presentation-only.
(
    // Stable authored key — industrial_hive bulkhead_wall EW companion TerrainUuid.
    key: "00000000-0000-0000-0000-01840a910009",
    display_name: "Bulkhead Wall (EW)",
    sim_kind: Wall(
        hp:               40,    // structural HP (copied from NS)
        armor_protection: 6,     // damage soak (copied)
        armor_hardness:   3,     // punch ignored (copied)
        height_band:      High,
    ),
    presenter_kind: Wall(
        graphic_name: "wall_ew", // EW sprite — NS wall rotated 90deg
    ),
    // The EW twin fills its own eight views with its own sprite; the pairs collapse later.
    views: [
        (view: Edge(North), sprite: "wall_ew"),
        (view: Edge(East), sprite: "wall_ew"),
        (view: Edge(South), sprite: "wall_ew"),
        (view: Edge(West), sprite: "wall_ew"),
        (view: Corner(NorthEast), sprite: "wall_ew"),
        (view: Corner(SouthEast), sprite: "wall_ew"),
        (view: Corner(SouthWest), sprite: "wall_ew"),
        (view: Corner(NorthWest), sprite: "wall_ew"),
    ],
    tags: [BlocksVision, BlocksPathfinding],
)
