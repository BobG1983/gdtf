// NS-orientation door — distinct authored visual tile. Closed door blocks LOS + pathfinding
// like a wall (sim_kind = Wall); Openable tag marks it as openable later.
// Orientation is never inferred — author places the correct orientation in a prefab.
(
    // Stable authored key — industrial_hive NS door TerrainUuid.
    key: "00000000-0000-0000-0000-01840a91000b",
    display_name: "Bulkhead Door (NS)",
    sim_kind: Wall(
        hp:               40,    // structural HP — as sturdy as a bulkhead wall
        armor_protection: 6,     // damage soak
        armor_hardness:   3,     // punch ignored
        height_band:      High,  // closed door fills the cell
    ),
    presenter_kind: Wall(
        graphic_name: "door_ns", // NS-running door sprite
    ),
    // Openable marks this as a door. Blocks vision + pathfinding while closed.
    tags: [Openable, BlocksVision, BlocksPathfinding],
)
