// Bulkhead wall. Solid wall blocks vision + pathfinding via BlocksVision / BlocksPathfinding tags.
(
    // Stable authored key — industrial_hive bulkhead_wall TerrainUuid.
    key: "00000000-0000-0000-0000-01840a910002",
    display_name: "Bulkhead Wall",
    sim_kind: Wall(
        hp:               40,    // structural HP
        armor_protection: 6,     // damage soak
        armor_hardness:   3,     // punch ignored
        height_band:      High,  // fills the cell
    ),
    presenter_kind: Wall(
        graphic_name: "wall",
    ),
    // One row per view a Wall owes — its four straight runs and the four turns between them.
    // The east and west runs carry the east-west art the deleted EW twin used to hold.
    views: [
        (view: Edge(North), sprite: "wall"),
        (view: Edge(East), sprite: "wall_ew"),
        (view: Edge(South), sprite: "wall"),
        (view: Edge(West), sprite: "wall_ew"),
        (view: Corner(NorthEast), sprite: "wall"),
        (view: Corner(SouthEast), sprite: "wall"),
        (view: Corner(SouthWest), sprite: "wall"),
        (view: Corner(NorthWest), sprite: "wall"),
    ],
    tags: [BlocksVision, BlocksPathfinding],
)
