// Shoulder-slung frag launcher — lobs a fragmentation charge that detonates on impact,
// spraying shrapnel across the surrounding cells. The blast does not care whose side you
// are on: everyone in the radius is torn (true friendly fire — resolution.md §2).
//
// GTW-541 (AoE CORE of GTW-41): the `Direct` mode is an ordinary single-target shot; the
// `Frag` mode carries a `hit_type: Blast(radius: 1)` AoE template — on impact it strikes
// EVERY occupant within one cell (Chebyshev, same storey) of the impact cell. `hit_type`
// defaults to `Single` when omitted, so the direct mode reads it as a normal shot.
(
    base_spread:   0.18,
    accuracy:      0.9,
    kickback:      0.10,
    fatal_bias:    0.0,
    damage:        7,
    punch:         2,
    shred:         1,
    damage_type:   Blast, // the matchup-wheel node (a DAMAGE flavour) — NOT the hit shape below
    magazine: (
        size:      6,
        reload_tu: 16,
    ),
    fire_mode: [
        // A precise direct lob at a single target — hit_type omitted → Single (the default).
        (kind: Single, cone_mult: 1.0, tu_percent: 0.40, shots: 1),
        // The fragmentation detonation — a radius-1 blast at the impact cell.
        (kind: Single, cone_mult: 1.0, tu_percent: 0.40, shots: 1, hit_type: Blast(radius: 1)),
    ],
    stable: false,
    handedness:    TwoHanded, // GTW-443: a two-handed launcher — refused below two working hands
)
