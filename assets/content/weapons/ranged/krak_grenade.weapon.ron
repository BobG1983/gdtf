// Krak grenade — a lobbed shaped demolition charge (GTW-546, child GTW-41d). A THROWN weapon:
// `trajectory: Arc` lofts it over walls / cover onto a target cell, blocked only by an intact
// roof (a hole / window lets it drop through). On landing it fans a radius-0 Blast — a
// SINGLE-cell demolition detonation with high punch: anti-armor, it caves the landing cell
// (and its occupant) rather than spraying a ring. Everyone in the (one-cell) radius is caught
// (true friendly fire — resolution.md §2).
//
// The single `Single` fire mode carries the AoE template (`hit_type: Blast(radius: 0)`) the
// throw dispatch reads at the arc's landing (GTW-541 resolver) — radius 0 = the landing cell
// only. `trajectory: Arc` makes it a blind lob — no line-of-sight gate. Its cone/accuracy
// fields satisfy serde but are UNUSED by the deterministic arc throw (no cone sample).
(
    base_spread:   0.20,
    accuracy:      0.8,
    kickback:      0.0,
    fatal_bias:    0.0,
    damage:        14,
    punch:         6,
    shred:         3,
    damage_type:   Blast, // shaped-charge concussion — the matchup-wheel node (a DAMAGE flavour)
    accepts:       Grenade, // GTW-775: a self-contained thrown demolition grenade (the munition)
    magazine: (
        size:      1,
        reload_tu: 22,
    ),
    trajectory: Arc, // GTW-546: a lobbed grenade — parabola blocked by roofs, passes holes/windows
    fire_mode: [
        // The demolition detonation — a radius-0 (single-cell) high-punch Blast at the landing.
        (kind: Single, cone_mult: 1.0, tu_percent: 0.40, shots: 1, hit_type: Blast(radius: 0)),
    ],
    stable: false,
    handedness:    OneHanded, // a one-handed thrown grenade
    // GTW-554: a thrown explosive takes NO fittings — `slots:` is deliberately omitted (the
    // empty default), so no attachment fits it (fail-closed).
)
