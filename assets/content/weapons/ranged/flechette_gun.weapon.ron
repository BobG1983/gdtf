// Flechette slinger — flings a fan of razored darts that tear and tumble through
// soft tissue. Ragged, rending wounds; cruel to anything lightly armored. No
// trigger discipline here: it only ever empties a screaming spray, never a tap.
(
    base_spread:   0.10,
    accuracy:      1.0,
    kickback:      0.05,
    fatal_bias:    0.0,
    damage:        6,   // GTW-374: halved from 12 (combat re-balance, slower lethality)
    punch:         2,   // GTW-374: halved from 5 (floor of 5/2)
    shred:         1,   // GTW-374: halved from 2
    damage_type:   Rend,
    accepts:       Slug,  // GTW-775: slings solid razored darts (a ballistic-cartridge munition)
    magazine: (
        size:      12,
        reload_tu: 12,
    ),
    // Always auto-firing — its only mode is the full spray.
    fire_mode: [
        (kind: Full, cone_mult: 1.7, tu_percent: 0.60, shots: 6),
    ],
    stable: false,
    handedness:    TwoHanded,  // GTW-443: a two-handed long-arm - refused below two working hands
    // GTW-554: the attachment SLOTS a long-arm offers (no item fitted by default).
    slots: [
        (Muzzle, 1),  // one muzzle thread
        (Sight,  1),  // one sight dovetail
        (Rail,   2),  // a full-length utility rail — two mods at once
    ],
)
