// Pressurized horror-tank — a hissing jet of corrosive chem that eats flesh and
// seal alike. Ugly, hated, and merciless against the unprotected.
(
    base_spread:   0.10,
    accuracy:      1.0,
    kickback:      0.05,
    fatal_bias:    0.0,
    damage:        6,   // GTW-374: halved from 12 (combat re-balance, slower lethality)
    punch:         2,   // GTW-374: halved from 5 (floor of 5/2)
    shred:         1,   // GTW-374: halved from 2
    damage_type:   Chem,
    magazine: (
        size:      12,
        reload_tu: 12,
    ),
    fire_mode: [
        (kind: Single, cone_mult: 1.0, tu_percent: 0.30, shots: 1),
        (kind: Burst,  cone_mult: 1.3, tu_percent: 0.50, shots: 3),
    ],
    stable: false,
    handedness:    TwoHanded,  // GTW-443: a two-handed long-arm - refused below two working hands
    // GTW-554: a pressure hose has no muzzle thread and no sight dovetail — only a tank rail.
    slots: [
        (Rail, 1),  // one utility mount on the tank harness
    ],
)
