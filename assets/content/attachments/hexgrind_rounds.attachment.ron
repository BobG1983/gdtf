// Hexgrind rounds — cursed ammunition that bites deeper: adds penetration (the weapon's
// WeaponPunch), so the shot ignores more armour. Data-driven attachment ITEM (the
// grimdark "HexgrindRounds" tag, now an item). Magnitude lives HERE on the item. Referenced
// by a weapon BY KEY in its `attachments:` list; applied to the weapon post-spawn.
(
    display_name: "Hexgrind Rounds",
    // Loaded-ammunition item — belongs in the magazine well, not on a utility rail.
    // (Mount point for an ammo feed, distinct from the AmmoType `accepts:` gate.)
    slot: Magazine,
    effects: [
        Penetration(6),  // +6 to the weapon's punch (armour ignored) — tunable
    ],
)
