// IndustrialHive PLAYER deployment prefab (GTW-433).
//
// The space-packing assembler (GTW-424) requires a `Player`-role fragment of at least the
// OQ-5 minimum side (~10x10) to anchor the human deployment zone, and an `Enemy`-role
// fragment for the strict-opposite zone (see enemy_deployment.prefab.ron). Before GTW-433
// the shipped `maps/` folder held only a 3x3 `Fill` sample, so procgen could not assemble a
// real level; this fragment + the enemy one make the live skirmish (theme: IndustrialHive,
// 30x30x4 board) generate a playable level.
//
// Footprint-local cells (origin 0,0); the assembler translates them onto the board by the
// placed region origin. Authored magnitudes (terrain HP / move cost) live in the referenced
// assets/content/terrain/*.terrain.ron pieces, not here — this fragment only places keys.
(
    // The level theme this fragment belongs to (a registry enumeration key).
    theme: IndustrialHive,
    // The footprint: 12 cells wide, 12 deep, 1 storey — comfortably above the OQ-5 ~10x10
    // player minimum and small enough to fit a board corner with the strict-opposite enemy
    // fragment + the inter-prefab seam on a 30x30 board.
    size: (width: 12, height: 12, levels: 1),
    // The deployment role this fragment plays — the human player's spawn zone.
    spawn_role: Player,
    // The walkable floor filling every open cell (and the seam cells at the edge openings).
    default_floor: "deck_floor",
    // A short L of bulkhead cover near the back corner of the deployment zone, so the
    // player spawns with something to break line-of-sight against (cover stats live in
    // the referenced piece .ron).
    walls: [
        (at: (cell: (x: 1, y: 1), level: 0), piece: "bulkhead_wall"),
        (at: (cell: (x: 2, y: 1), level: 0), piece: "bulkhead_wall"),
        (at: (cell: (x: 1, y: 2), level: 0), piece: "bulkhead_wall"),
    ],
    // A barricade prop mid-zone for forward cover.
    scatter: [
        (at: (cell: (x: 6, y: 6), level: 0), piece: "barricade"),
    ],
    // C6 — the boundary-edge cells the inter-prefab 1-cell seam connects through. >= 1 is
    // required; openings on all four mid-edges keep the zone connectable whichever corner /
    // edge anchor procgen picks for the player.
    edge_openings: [
        (at: (cell: (x: 11, y: 6), level: 0)),  // east edge (toward board interior from a left/corner anchor)
        (at: (cell: (x: 0, y: 6), level: 0)),   // west edge
        (at: (cell: (x: 6, y: 11), level: 0)),  // north edge
        (at: (cell: (x: 6, y: 0), level: 0)),   // south edge
    ],
)
