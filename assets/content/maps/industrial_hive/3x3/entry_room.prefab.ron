// A sample Industrial-Hive level-fragment prefab (GTW-418).
//
// This is a 3x3x1 footprint demonstrating the canonical prefab schema the GTW-424
// space-packing assembler and the GTW-432 editor saver both consume. It carries:
//   - the theme it draws from + its footprint size + its spawn role (the three registry
//     enumeration keys),
//   - a default floor + one wall (reusing the situation value-graph terrain piece keys),
//   - >= 1 edge opening (the C6 connectivity-by-construction seam — a prefab with ZERO is
//     rejected fail-closed at load),
//   - the RESERVED ai_route_nodes field (the absorbed GTW-86 authoring; may be empty).
//
// Authored magnitudes (terrain HP / move cost) live in the referenced
// assets/content/terrain/*.terrain.ron pieces, not here — this fragment only places keys.
(
    // The level theme this fragment belongs to (a registry enumeration key).
    theme: IndustrialHive,
    // The footprint: 3 cells wide, 3 deep, 1 storey (a registry enumeration key).
    size: (width: 3, height: 3, levels: 1),
    // The deployment role this fragment plays in an assembled level (a registry
    // enumeration key) — generic connective fill.
    spawn_role: Fill,
    // The walkable floor filling every open cell (and the seam cell at the edge opening).
    default_floor: "deck_floor",
    // One wall along the back edge of the fragment.
    walls: [
        (at: (cell: (x: 0, y: 0), level: 0), piece: "bulkhead_wall"),
    ],
    // C6 — the edge openings the inter-prefab 1-cell seam connects through. >= 1 required;
    // this fragment exposes a doorway on its east boundary edge (x = 2, the footprint's
    // far edge) at mid-height.
    edge_openings: [
        (at: (cell: (x: 2, y: 1), level: 0)),
    ],
    // RESERVED (C1 / C5, absorbed GTW-86): one AI navigation waypoint at the fragment
    // centre. Nothing consumes this yet; it demonstrates the field is authorable today.
    ai_route_nodes: [
        (cell: (x: 1, y: 1), level: 0),
    ],
)
