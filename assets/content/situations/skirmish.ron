// GDTF authored situation — "skirmish": a small, valid battlefield the setup pours
// into the battle ECS (GTW-205 / E10.3). This is AUTHORED CONTENT (a generated /
// hand-built battlefield), not balance tuning. It loads as a loose `.ron` through the
// RonAsset<Situation> loader, exactly like the theme. Render-free, pixel-free:
// positions are (cell, level) keys (x/y cells, a storey index), never pixels.
//
// GTW-384 (the two-layer stat model): each gang ROSTER member authors the EIGHT DIRECT
// ATTRIBUTES (the raw potential) — NOT the computed stats. Those, plus identity + weapon
// + armor, now live in the gang roster files (assets/content/gangs/*.gang.ron), NOT here.
//
// GTW-414 (schema v2): each placed ganger is a REFERENCE — it names its `gang` (a gang
// roster file stem) and the `member` within it (by name), then carries only the PLACEMENT
// (cell / facing / stance / aiming / life_state) and the `faction` the situation assigns
// for THIS battle. The roster (identity + 8 attributes + weapon + armor) is resolved at
// setup against the GangRegistry built from the gangs folder.
//
// GTW-433 (theme+size procgen migration): this situation authors ONLY the THEME + the
// coarse GRID SIZE + the placed gangers. It NO LONGER authors inline terrain (walls /
// scatter / slabs / default_floor / floors / vertical_links): the TERRAIN is PROCGEN-
// generated at BattleScapeState::Generation from `theme` + `grid_size` against the loaded
// prefab library (the sim's `generate_level`, GTW-431), driven by the battle's deterministic
// seed. The authored gangers are merged over that generated terrain. The Situation schema's
// terrain fields are `#[serde(default)]` (GTW-414 v2), so omitting them parses to empty —
// the procgen step fills them in.
(
    // The level THEME (GTW-491) — now the UUID-keyed reference to the migrated IndustrialHive
    // UuidThemeDef (assets/content/terrain/industrial_hive/industrial_hive.terrain_theme.ron), resolvable
    // in the UuidThemeRegistry. GTW-491 reconciled the GTW-490 additive `theme_uuid` field into
    // this canonical `theme` (the sim theme is now this one ThemeUuid; the legacy LevelTheme enum
    // is no longer authored here). IndustrialHive = the manufactorum decking / bulkheads of the
    // hive proper — the visual + content family this battlefield draws from.
    theme: "00000000-0000-0000-0000-01840a900001",  // migrated IndustrialHive ThemeUuid — resolves in UuidThemeRegistry
    // The coarse GRID dimensions (GTW-414) — width × height × storey-count, each validated
    // to the sim's coarse-grid maxima (60 / 60 / 8). This is the BOARD procgen packs the
    // theme's prefab fragments into (a 30×30×4 board comfortably holds the IndustrialHive
    // player + enemy deployment prefabs at opposite corners with the inter-prefab seam).
    grid_size: (width: 30, height: 30, levels: 4),  // coarse grid extent (w × h × storeys) — the procgen board
    // The placed gangers (GTW-414 schema v2) — each REFERENCES a gang + member by name and
    // supplies its placement + faction. The roster (attributes / weapon / armor) is resolved
    // against the gangs folder at setup. Two gangs (faction 0 and faction 1) face off. These
    // placements survive procgen (the generated terrain is merged OVER them — GTW-433).
    gangers: [
        // --- Gang 0: a standing rifleman on the ground floor, facing east. ---
        (
            gang:       "gang_0",      // gang ROSTER ref — resolves to assets/content/gangs/gang_0.gang.ron
            member:     "Alex Mercer", // member within gang_0 — its identity + 8 attributes + weapon + armor come from there
            at:         (cell: (x: 5, y: 6), level: 0),  // (cell, level) it spawns at — its Position
            faction:    0,            // SIDE assignment for this battle — gang 0 (placement, not roster)
            facing:     East,         // which of the 8 grid directions it faces
            stance:     Standing,     // posture — upright (full silhouette, full stability gate)
            aiming:     false,        // aim-mode flag — hip-firing, not aimed
            life_state: Alive,        // terminal life state — up and fighting
        ),
        // --- Gang 0: a grenadier beside Alex, facing east — carries the ARC grenade launcher, so
        // the contextual THROW act is LIVE in the shipped playable skirmish (GTW-546). Player
        // faction (0): the AI never acts for the player, so this does NOT perturb the seeded
        // autobattle enemy path. ---
        (
            gang:       "gang_0",      // gang ROSTER ref — resolves to assets/content/gangs/gang_0.gang.ron
            member:     "Kira Vann",   // the grenadier member within gang_0 — wields the grenade_launcher (TrajectoryStyle::Arc)
            at:         (cell: (x: 5, y: 8), level: 0),  // (cell, level) it spawns at — beside Alex on the player side
            faction:    0,            // SIDE assignment for this battle — gang 0 (the player side)
            facing:     East,         // faces toward the enemy deployment
            stance:     Standing,     // posture — upright
            aiming:     false,        // aim-mode flag — hip-firing (the blind arc throw ignores aim anyway)
            life_state: Alive,        // terminal life state — up and fighting
        ),
        // --- Gang 1: a crouching, aimed defender across the floor, facing west. ---
        (
            gang:       "gang_1",      // gang ROSTER ref — resolves to assets/content/gangs/gang_1.gang.ron
            member:     "Vex 1",       // member within gang_1
            at:         (cell: (x: 12, y: 9), level: 0),  // (cell, level) it spawns at
            faction:    1,            // SIDE assignment — gang 1 (the opposing side)
            facing:     West,         // faces back toward gang 0
            stance:     Crouching,    // posture — kneeling (compressed silhouette, steadier)
            aiming:     true,         // aim-mode flag — aimed shot (narrows the cone at a TU premium)
            life_state: Alive,        // terminal life state — up and fighting
        ),
        // --- Gang 1: a second crouching, aimed defender, facing west. ---
        (
            gang:       "gang_1",      // gang ROSTER ref — the SAME gang_1 roster as Vex 1
            member:     "Vex 2",       // member within gang_1
            at:         (cell: (x: 12, y: 12), level: 0),  // (cell, level) it spawns at
            faction:    1,            // SIDE assignment — gang 1 (the opposing side)
            facing:     West,         // faces back toward gang 0
            stance:     Crouching,    // posture — kneeling (compressed silhouette, steadier)
            aiming:     true,         // aim-mode flag — aimed shot (narrows the cone at a TU premium)
            life_state: Alive,        // terminal life state — up and fighting
        ),
    ],
    // NOTE (GTW-433): NO terrain fields are authored here. walls / scatter / slabs /
    // default_floor / floors / vertical_links are GENERATED by procgen at Generation from
    // the theme + grid_size above; the Situation schema defaults them to empty when omitted.
    //
    // GTW-545 (area-damage fields): one authored toxic-waste pool between the two deployment
    // corners, so a persistent damage zone is LIVE in the shipped playable battle — any ganger
    // that traverses this cell loses HP each turn unless its worn armor grants whole-source
    // immunity (Flak / Hazard for a Chem pool). The `fields:` list is situation-owned placement
    // data (like the gangers); it carries through the procgen terrain merge unchanged and is
    // resolved against the loaded FieldDefRegistry catalog (assets/content/fields/*.field.ron)
    // at setup. Field ticks are FLAT + RNG-FREE, so seeding this does NOT perturb the
    // deterministic seeded-RNG shot/injury autobattle.
    fields: [
        (at: (cell: (x: 9, y: 8), level: 0), field: "toxic_waste_pool"),  // a persistent Chem pool between the deployment corners — drains HP each turn unless armor grants immunity
    ],
)
