// Seeded sprite def — `stair_up`, derived from the shipped role table
// (atlas index 29 on the 16-column, 16px-cell terrain sheet).
// A load-time test pins this def against the table so they cannot drift.
(
    source: Sheet(
        sheet: "sprites/alt_tileset_terrain.png",  // the presenter's terrain sheet (SheetRole::Terrain)
        rect: (x: 208, y: 16, w: 16, h: 16),  // sheet col 13, row 1 — one 16x16 cell
    ),
    // Presenter draws each tile as a unit quad CENTERED on its cell world position,
    // so the anchor is the sprite CENTER — (8, 8) of a 16x16 tile.
    anchor: (x: 8, y: 8),
)
