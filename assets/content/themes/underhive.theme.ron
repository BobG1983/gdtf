// Underhive theme — the lawless tunnels and rockcrete warrens beneath the hive.
// A per-theme NAMED-TILE catalog (GTW-409): rubble ground, scrap barricades, broken
// scatter. Every magnitude is tunable DATA — NOT pinned by tests. The atlas index is
// the OPAQUE row-major index into assets/sprites/alt_tileset_terrain.png the PRESENTER
// resolves; the sim never renders it.
(
    theme:         Underhive,
    default_floor: "rockcrete_floor",   // the tile a generated level fills empty ground with (C3)
    tiles: {
        "rockcrete_floor": (
            display_name: "Rockcrete Floor",
            atlas_index:  128,           // bolted/riveted grey panel (underhive variety)
            kind: Floor(
                move_cost: 5,            // rougher ground — dearer step (tunable)
            ),
        ),
        "tunnel_wall": (
            display_name: "Tunnel Wall",
            atlas_index:  0,             // heavy dark blocking wall strip
            kind: Wall((
                max_hp:           55,    // structural HP (tunable)
                armor_protection: 7,     // damage-reduction (tunable)
                armor_hardness:   3,     // penetration shrugged off (tunable)
                height_band:      High,  // full-height blocking geometry
            )),
        ),
        "scrap_barricade": (
            display_name: "Scrap Barricade",
            atlas_index:  248,           // chest-high improvised cover
            kind: Scatter((
                max_hp:           18,    // fragile scrap (tunable)
                armor_protection: 1,     // damage-reduction (tunable)
                armor_hardness:   0,     // penetration shrugged off (tunable)
                height_band:      Low,   // LOW scatter; a MID/HIGH round clears it
            )),
        ),
        "rubble_pile": (
            display_name: "Rubble Pile",
            atlas_index:  295,           // sparse broken-debris scatter
            kind: Scatter((
                max_hp:           10,    // very fragile rubble (tunable)
                armor_protection: 0,     // damage-reduction (tunable)
                armor_hardness:   0,     // penetration shrugged off (tunable)
                height_band:      Low,   // LOW scatter
            )),
        ),
    },
)
