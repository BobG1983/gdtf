// GTW-440 TORSO-pool standin injury. A Critical torso wound — a gut wound: gushing,
// life-threatening, a lasting collapse of resilience. Torso injuries key to the
// Toughness / Hp stat map (resolution.md injury tables); a Critical is a lost-level
// debuff plus a heavy bleed. KEY = file stem minus `.injury` => `gut_wound`.
(
    name:         "Gut Wound",                               // display InjuryName (inspect-panel label)
    category:     Torso,                                     // routes into the Torso category pool; matches the owning subfolder
    severity:     Critical,                                  // Minor | Major | Critical (None/Fatal never tabled)
    popup_text:   "GUT WOUND",                               // -> floating combat text (FCT)
    log_text:     "takes a gut wound",                       // -> combat log line ("<name> takes a gut wound")
    inspect_text: "Gut Wound -- -3 Toughness, -2 Hp, bleeding", // -> inspect panel (per-ganger injury list)
    effects: [
        Modify(stat: Toughness, amount: -3),                 // torso -> Toughness; Critical lost-level debuff
        Modify(stat: Hp,        amount: -2),                 // torso -> Hp; docks the derived Hp pool MAX
        Bleeding(amount: 3),                                 // torso -> Hp drain; heavy per-turn bleed
    ],
    // post_heal omitted -> defaults to Deferred (GTW-23 Healing owns the semantics).
)
