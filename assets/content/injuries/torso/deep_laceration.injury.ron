// TORSO-pool standin injury. A Minor torso wound — a deep laceration that
// keeps bleeding. Torso injuries key to the Toughness / Hp stat map (resolution.md
// injury tables); a bleeding Minor drains HP each turn (the existing bleed runtime).
// KEY = file stem minus `.injury` => `deep_laceration`.
(
    name:         "Deep Laceration",             // display InjuryName (inspect-panel label)
    category:     Torso,                         // routes into the Torso category pool; matches the owning subfolder
    severity:     Minor,                         // Minor | Major | Critical (None/Fatal never tabled)
    popup_text:   "LACERATED",                   // -> floating combat text (FCT)
    log_text:     "is deeply lacerated",         // -> combat log line ("<name> is deeply lacerated")
    inspect_text: "Deep Laceration -- bleeding", // -> inspect panel (per-ganger injury list)
    effects: [
        Bleeding(amount: 1),                     // torso -> Hp drain; a per-turn HP bleed (not a stat delta)
    ],
    // post_heal omitted -> defaults to Deferred (Healing owns the semantics).
)
