// ARM-pool standin injury. A Minor arm wound — a deep bruise that weakens the
// grip. Arm injuries key to the Strength / Aim / DisableHand stat map (resolution.md
// injury tables); a Minor is a LIGHT debuff. Side-agnostic (both arms share the Arm
// pool); the rolled struck part records which arm. KEY = stem => `bruised_forearm`.
(
    name:         "Bruised Forearm",             // display InjuryName (inspect-panel label; side-agnostic)
    category:     Arm,                            // routes into the shared Arm category pool; matches the owning subfolder
    severity:     Minor,                          // Minor | Major | Critical (None/Fatal never tabled)
    popup_text:   "FOREARM BRUISED",              // -> floating combat text (FCT)
    log_text:     "bruises a forearm",            // -> combat log line ("<name> bruises a forearm")
    inspect_text: "Bruised Forearm -- -1 Strength", // -> inspect panel (per-ganger injury list)
    effects: [
        Modify(stat: Strength, amount: -1),       // arm -> Strength; light Minor debuff (weakened grip)
    ],
    // post_heal omitted -> defaults to Deferred (Healing owns the semantics).
)
