// GTW-440 HEAD-pool standin injury. A Major head wound — a wrecked jaw, blinding pain
// that dulls both wits and aim. Head injuries key to the Aim / Cool stat map
// (resolution.md injury tables); a Major is a -1/broken-level debuff (here -2 across two
// stats). KEY = file stem minus `.injury` => `shattered_jaw`.
(
    name:         "Shattered Jaw",                       // display InjuryName (inspect-panel label)
    body_part:    Head,                                  // routes into the Head category pool
    severity:     Major,                                 // Minor | Major | Critical (None/Fatal never tabled)
    popup_text:   "JAW SHATTERED",                       // -> floating combat text (FCT)
    log_text:     "has its jaw shattered",               // -> combat log line
    inspect_text: "Shattered Jaw -- -2 Cool, -1 Aim",    // -> inspect panel (per-ganger injury list)
    effects: [
        Modify(stat: Cool, amount: -2),                  // head -> Cool; Major-level debuff (blinding pain)
        Modify(stat: Aim,  amount: -1),                  // head -> Aim; an injury MAY carry more than one effect
    ],
    // post_heal omitted -> defaults to Deferred (GTW-23 Healing owns the semantics).
)
