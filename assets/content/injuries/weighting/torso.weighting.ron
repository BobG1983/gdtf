// GTW-440 per-CATEGORY weighting for the TORSO pool (one weighting file per category;
// the Torso category = the Torso body part). Every `injury:` is an InjuryName KEY (the
// `.injury.ron` file stem under torso/); an unknown key WARNs + is skipped at
// table-build. Authored order does NOT affect determinism (canonically sorted at build).
// Torso injuries key to the Toughness / Hp stat map (resolution.md injury tables).
(
    body_part: Torso,                                      // routes into the Torso category pool
    minor:    [                                            // Minor bucket (light debuffs)
        (injury: "cracked_rib",     weight: 10),           // -1 Toughness
        (injury: "deep_laceration", weight: 7),            // bleeding (Hp drain)
    ],
    major:    [                                            // Major bucket (-1/-2 broken-level)
        (injury: "punctured_lung",    weight: 5),          // -2 Toughness, bleeding
        (injury: "fractured_sternum", weight: 4),          // -2 Hp, -1 Toughness
    ],
    critical: [                                            // Critical bucket (lost-level)
        (injury: "gut_wound", weight: 3),                  // -3 Toughness, -2 Hp, bleeding
    ],
)
