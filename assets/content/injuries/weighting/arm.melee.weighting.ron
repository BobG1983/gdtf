// MELEE per-source weighting for the ARM pool (both arms share it) — the SAME
// shared arm injury defs as arm.weighting.ron (ranged), weighted for close combat. No
// injury def is duplicated; only the weights differ per source (resolution.md injury
// tables). A parried melee blow dislocates a shoulder or shatters a hand more readily.
(
    category: Arm,                                         // the shared Arm category this file weights
    context:  Melee,                                       // the melee per-source table
    minor:    [                                            // Minor bucket (light debuffs)
        (injury: "torn_muscle",     weight: 8),            // -1 Aim
        (injury: "bruised_forearm", weight: 6),            // -1 Strength
    ],
    major:    [                                            // Major bucket
        (injury: "dislocated_shoulder", weight: 7),        // -2 Strength, -1 Aim (a wrenched parry)
        (injury: "shattered_hand",      weight: 6),        // DisableHand (struck side) + -2 Shooting
    ],
    critical: [                                            // Critical bucket
        (injury: "mangled_arm", weight: 3),                // DisableHand + -3 Strength, -2 Shooting
    ],
)
