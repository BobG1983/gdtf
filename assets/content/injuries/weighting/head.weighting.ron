// GTW-437 SAMPLE weighting (loader fixture) for the Head. The full >=6-entries-per-
// severity content floor is GTW-440 — this references only the two sample head injuries
// so they resolve + can be rolled. `injury:` is an InjuryName KEY (the `.injury.ron`
// file stem); an unknown key WARNs + is skipped at table-build. Authored order does NOT
// affect determinism (entries are canonically sorted at build).
(
    body_part: Head,                                       // the part this table weights
    minor:    [ (injury: "scalp_graze", weight: 10) ],     // Minor bucket
    major:    [],                                          // Major bucket (GTW-440 fills the floor)
    critical: [ (injury: "lost_eye",    weight: 4) ],      // Critical bucket
)
