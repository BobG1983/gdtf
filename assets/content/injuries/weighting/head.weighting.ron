// Per-CATEGORY weighting for the HEAD pool. This is the RANGED
// per-source table — one weighting file per (category, context). Every `injury:` is an
// InjuryName KEY (the `.injury.ron` file stem under head/); an unknown key WARNs + is
// skipped at table-build. Authored order does NOT affect determinism (entries are
// canonically sorted at build). Head injuries key to the Aim / Cool stat map
// (resolution.md injury tables).
//
// WORKED EXAMPLE (ranged half): a `broken_nose` from a RANGED shot is near-zero
// (weight 1) — a bullet to the face is a graze or a lost eye, not a broken nose — whereas
// the SAME shared `broken_nose` def is weighted high in the melee table (head.melee).
(
    category: Head,                                        // the Head category this file weights
    context:  Ranged,                                      // the ranged per-source table
    minor:    [                                            // Minor bucket (light debuffs)
        (injury: "scalp_graze", weight: 10),               // -1 Cool
        (injury: "broken_nose", weight: 1),                // -1 Aim (near-zero for a ranged hit)
        (injury: "concussion",  weight: 6),                // -1 Cool
    ],
    major:    [                                            // Major bucket (-1/-2 broken-level)
        (injury: "shattered_jaw", weight: 5),              // -2 Cool, -1 Aim
    ],
    critical: [                                            // Critical bucket (lost-level)
        (injury: "lost_eye", weight: 4),                   // -2 Aim, -1 Cool
    ],
)
