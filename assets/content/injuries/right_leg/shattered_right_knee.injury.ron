// GTW-444 "Hampered" leg injury (RIGHT). A Major wound that wrecks the right knee: the
// ganger keeps fighting but moves slower — every movement step costs more TU. "Hampered"
// is the player-facing status term; "Shattered Right Knee" is the wound's flavor name;
// MovementCostMul is the neutral code name for the per-step movement-TU multiplier.
// The full leg-injury content floor (>=6 per severity per part) remains GTW-440.
// KEY = file stem minus `.injury` => `shattered_right_knee`.
(
    name:         "Shattered Right Knee",                       // display InjuryName (inspect-panel label)
    body_part:    RightLeg,                                     // authoritative; must match the owning subfolder
    severity:     Major,                                        // Minor | Major | Critical (None/Fatal never tabled)
    popup_text:   "RIGHT KNEE SHATTERED",                       // -> floating combat text (FCT)
    log_text:     "shatters a knee",                            // -> combat log line ("<name> shatters a knee")
    inspect_text: "Shattered Right Knee -- Hampered (slower movement), -1 Speed", // -> inspect panel
    effects: [
        MovementCostMul(1.5),                                   // GTW-444: each movement step costs 1.5x TU (>=1.0 = slower)
        Modify(stat: Speed, amount: -1),                        // flavor: a wrecked knee also docks the Speed attribute
    ],
    // post_heal omitted -> defaults to Deferred (GTW-23 Healing owns the semantics).
)
