// hazard_suit — sealed chem/bio coveralls that wrap the limbs as fully as the
// core. Baseline protection, even all over, nowhere left bare — the suit that
// covers what others leave exposed.
// Re-balance: floor / protection / hardness HALVED (floor of n/2); integrity UNCHANGED.
(
    head:      (floor: 0, protection: 3, integrity: 50, hardness: 1, armor_type: Hazard),
    torso:     (floor: 0, protection: 4, integrity: 60, hardness: 1, armor_type: Hazard),  // most hits land here
    left_arm:  (floor: 0, protection: 2, integrity: 45, hardness: 1, armor_type: Hazard),
    right_arm: (floor: 0, protection: 2, integrity: 45, hardness: 1, armor_type: Hazard),
    left_leg:  (floor: 0, protection: 2, integrity: 50, hardness: 1, armor_type: Hazard),
    right_leg: (floor: 0, protection: 2, integrity: 50, hardness: 1, armor_type: Hazard),
)
