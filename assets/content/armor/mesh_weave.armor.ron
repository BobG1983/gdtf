// mesh_weave — a reinforced undersuit worn close to the skin. A flexible woven
// layer with no weak seam and no standout stat: even coverage, steady endurance
// that runs a notch above baseline, the honest all-rounder that holds together
// while flashier suits give out.
// GTW-374 re-balance: floor / protection / hardness HALVED (floor of n/2); integrity UNCHANGED.
(
    head:      (floor: 0, protection: 3, integrity: 60, hardness: 1, armor_type: Reinforced),
    torso:     (floor: 0, protection: 4, integrity: 70, hardness: 1, armor_type: Reinforced),  // most hits land here
    left_arm:  (floor: 0, protection: 2, integrity: 55, hardness: 1, armor_type: Reinforced),
    right_arm: (floor: 0, protection: 2, integrity: 55, hardness: 1, armor_type: Reinforced),
    left_leg:  (floor: 0, protection: 2, integrity: 60, hardness: 1, armor_type: Reinforced),
    right_leg: (floor: 0, protection: 2, integrity: 60, hardness: 1, armor_type: Reinforced),
)
