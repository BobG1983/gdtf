// carapace_plate — the heaviest shell on the wheel. Rigid plate turns more punch
// aside than any other suit; the trade is bulk and a body that slows you down.
// Top protection, baseline endurance — it stops the hit hard, and the head and core
// plates seal so tight that nothing slips past unblunted.
// Re-balance: floor / protection / hardness HALVED (floor of n/2); integrity UNCHANGED.
(
    head:      (floor: 0, protection: 4, integrity: 55, hardness: 2, armor_type: Plated),
    torso:     (floor: 0, protection: 5, integrity: 65, hardness: 2, armor_type: Plated),  // top protection on the wheel — plate turns the hit
    left_arm:  (floor: 0, protection: 3, integrity: 50, hardness: 1, armor_type: Plated),
    right_arm: (floor: 0, protection: 3, integrity: 50, hardness: 1, armor_type: Plated),
    left_leg:  (floor: 0, protection: 3, integrity: 55, hardness: 1, armor_type: Plated),
    right_leg: (floor: 0, protection: 3, integrity: 55, hardness: 1, armor_type: Plated),
)
