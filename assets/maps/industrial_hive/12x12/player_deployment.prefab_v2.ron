// GTW-490 migration of assets/content/maps/industrial_hive/12x12/player_deployment.prefab.ron
// to the NEW UUID-keyed PrefabSpecV2 model (GTW-486/489), under the NEW `maps/<theme>/<size>/`
// root. The legacy `walls` + `scatter` lists collapse into ONE `placements` list, each mapping
// an old stem ref to the migrated industrial_hive TerrainUuid. The old `default_floor` (a theme
// concern) and `edge_openings` (no v2 field) are dropped. `role` is OMITTED -> serde-default
// SpawnRole::Fill (GTW-490 migration recipe step 3 / C3 "role defaults applied"); the legacy
// Player role intent is re-keyed by the v2 assembler (T07b), which does not yet consume this.
(
    // The IndustrialHive ThemeUuid (must match the migrated terrain_theme.ron key).
    theme: "00000000-0000-0000-0000-01840a900001",
    // The 12x12x1 footprint (unchanged from the legacy fragment).
    size: (width: 12, height: 12, levels: 1),
    // The placed pieces — the legacy `walls` (bulkhead L) + `scatter` (barricade), by migrated UUID.
    placements: [
        // old `walls` — a short L of bulkhead cover near the back corner.
        (piece: "00000000-0000-0000-0000-01840a910002", at: (cell: (x: 1, y: 1), level: 0)),
        (piece: "00000000-0000-0000-0000-01840a910002", at: (cell: (x: 2, y: 1), level: 0)),
        (piece: "00000000-0000-0000-0000-01840a910002", at: (cell: (x: 1, y: 2), level: 0)),
        // old `scatter` — a barricade prop mid-zone for forward cover.
        (piece: "00000000-0000-0000-0000-01840a910001", at: (cell: (x: 6, y: 6), level: 0)),
    ],
)
