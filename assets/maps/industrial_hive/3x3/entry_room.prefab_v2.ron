// An IndustrialHive 3x3 level-fragment prefab in the UUID-keyed PrefabSpecV2 model
// (GTW-486/489), under the `maps/<theme>/<size>/` root. The schema's ONE `placements` list maps
// each placed piece to a migrated industrial_hive TerrainUuid. The level-wide default floor is a
// theme concern now (the theme's default_floor), NOT a prefab placement; the v2 schema authors
// no per-prefab openings (connectivity is by-construction in the v2 assembler — the 1-cell
// default_floor seam every placement reserves). `role` is OMITTED -> serde-default
// SpawnRole::Fill (GTW-490 migration recipe step 3 / C3 "role defaults applied").
(
    // The IndustrialHive ThemeUuid (must match the migrated terrain_theme.ron key).
    theme: "00000000-0000-0000-0000-01840a900001",
    // The 3x3x1 footprint (unchanged from the legacy fragment).
    size: (width: 3, height: 3, levels: 1),
    // The placed pieces — the legacy `walls` list, by migrated TerrainUuid.
    placements: [
        // old `bulkhead_wall` @ (0,0,0)
        (piece: "00000000-0000-0000-0000-01840a910002", at: (cell: (x: 0, y: 0), level: 0)),
    ],
)
