// GTW-490 migration of assets/content/maps/industrial_hive/3x3/entry_room.prefab.ron to the
// NEW UUID-keyed PrefabSpecV2 model (GTW-486/489), under the NEW `maps/<theme>/<size>/` root
// (SEPARATE from the legacy content/maps/ tree so the still-live legacy loader is untouched).
// The legacy schema's four split lists collapse into ONE `placements` list, each mapping an
// old stem ref to the migrated industrial_hive TerrainUuid. The old `default_floor` is a theme
// concern now (the theme's default_floor), NOT a prefab placement; the old `edge_openings` has
// no field in v2 (connectivity is by-construction in the v2 assembler, T07b). `role` is OMITTED
// -> serde-default SpawnRole::Fill (GTW-490 migration recipe step 3 / C3 "role defaults applied").
(
    // The IndustrialHive ThemeUuid (must match the migrated terrain_theme.ron key).
    theme: "00000000-0000-0000-0000-01840a900001",
    // The 3x3x1 footprint (unchanged from the legacy fragment).
    size: (width: 3, height: 3, levels: 1),
    // The placed pieces — the legacy `walls` list, by migrated TerrainUuid.
    placements: [
        // old `bulkhead_wall` @ (0,0,0)
        (piece: "00000000-0000-0000-0000-01840a910002", at: (cell: (x: 0, y: 0), level: 0)),
    ],
)
