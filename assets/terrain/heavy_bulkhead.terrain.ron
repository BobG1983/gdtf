// Heavy bulkhead — solid blocking wall geometry. A destructible structural piece;
// stats match the inline values the shipped skirmish.ron used before the GTW-396
// migration (behavior-preserving: same HP / armor / band). This is the authored
// DATA counterpart to what was previously hard-coded in CoverSpawn fields.
(
    graphic:  "wall",            // presenter TileRoles key -> alt_tileset_terrain atlas (sim never resolves it)
    footfall: "none",            // footfall sound key — walls have no walkable surface footfall (no audio system yet)
    kind: Wall((
        max_hp:           120,   // structural HP — how much it soaks before it is destroyed (tunable)
        armor_protection: 8,     // damage-reduction stat — same armor model as a ganger (tunable)
        armor_hardness:   4,     // penetration the wall shrugs off (tunable)
        height_band:      High,  // clearance band — a tall wall; nothing flies strictly over it within a storey
    )),
)
