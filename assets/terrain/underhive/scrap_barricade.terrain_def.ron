    key: "00000000-0000-0000-0000-01840a920003",
    display_name: "Scrap Barricade",
    sim_kind: Cover(
        hp:               18,    // fragile scrap (copied)
        armor_protection: 1,     // damage-reduction (copied)
        armor_hardness:   0,     // penetration shrugged off (copied)
        height_band:      Low,   // LOW scatter; a MID/HIGH round clears it
