// Concussive bolt-thrower — fires a compressed blast charge straight down-range
// (no arc, no lob). Lands like a hammer of pressure that ruptures from within.
(
    base_spread:   0.10,
    accuracy:      1.0,
    kickback:      0.05,
    fatal_bias:    0.0,
    damage:        12,
    punch:         5,
    shred:         2,
    damage_type:   Blast,
    magazine: (
        size:      12,
        reload_tu: 12,
    ),
    fire_mode: [
        (kind: Single, cone_mult: 1.0, tu_percent: 0.30, shots: 1),
        (kind: Burst,  cone_mult: 1.3, tu_percent: 0.50, shots: 3),
    ],
    stable: false,
)
