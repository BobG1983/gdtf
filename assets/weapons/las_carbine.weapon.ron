// Clean coherent-light carbine — a snapping crack and a scorched line of sight.
// No recoil to fight, no slug to deflect: it simply burns where it's pointed.
(
    base_spread:   0.10,
    accuracy:      1.0,
    kickback:      0.05,
    fatal_bias:    0.0,
    damage:        6,   // GTW-374: halved from 12 (combat re-balance, slower lethality)
    punch:         2,   // GTW-374: halved from 5 (floor of 5/2)
    shred:         1,   // GTW-374: halved from 2
    damage_type:   Las,
    magazine: (
        size:      12,
        reload_tu: 12,
    ),
    fire_mode: [
        (kind: Single, cone_mult: 1.0, tu_percent: 0.30, shots: 1),
        (kind: Burst,  cone_mult: 1.3, tu_percent: 0.50, shots: 3),
    ],
    stable: false,
)
