// GDTF authored weapon — "lasgun" (the weapon KEY = WeaponName = the filename stem
// minus the `.weapon` infix; this file is `lasgun.weapon.ron`, key "lasgun").
// A steady las-weapon: accurate, low recoil, las-type beams. This is AUTHORED
// CONTENT (a per-weapon stat block), folder-loaded as a loose `.weapon.ron` through
// the RonAsset<WeaponSpec> loader (GTW-257) and resolved at battle setup into the
// WeaponBundle inserted onto every ganger that references this key. The dedicated
// `.weapon.ron` extension makes the folder load unambiguous among GDTF's many
// `.ron` loaders. The file does NOT author a `name` field — the name is supplied
// from the key ("lasgun"). Render-free, pixel-free: every number is a weapon stat
// the §1 cone / §6 severity math reads. Magnitudes are TUNING DATA (edit freely);
// they are NOT pinned by tests. Each line says what it authors.
(
    base_spread:   0.18,      // intrinsic angular dispersion (radians) before situational mults — a tight beam
    accuracy:      1.15,      // concentration weapon term — above 1.0 (clusters tightly toward center)
    kickback:      0.05,      // per-round recoil added in a burst — barely climbs
    fatal_bias:    0.5,       // severity-score addend (consumed by E3) — light wounding push
    damage:        10,        // base damage of a hit before armor
    punch:         6,         // armor protection a hit ignores (penetration)
    shred:         1,         // extra integrity damage per hit (attacks armor durability)
    damage_type:   Las,       // the matchup-wheel node this weapon emits (node 6 — beams)
    magazine_size: 20,        // rounds before a reload
    // The fire-mode selector — single / single+burst (the lasgun offers no full-auto).
    // Each rung carries its own per-mode numbers: a name, a cone multiplier, the
    // fraction of the TU pool a shot costs, and the round count per shot action.
    fire_mode: SingleBurst(
        single: (
            name:       "single",  // human-facing mode label
            cone_mult:  1.0,       // selector cone multiplier — single is the baseline (≈ 1)
            tu_percent: 0.25,      // TU% — a single shot costs 25% of the TU pool (cheap, steady)
            shots:      1,         // rounds fired per shot action
        ),
        burst: (
            name:       "burst",   // human-facing mode label
            cone_mult:  1.15,      // selector cone multiplier — a tight, controlled burst
            tu_percent: 0.40,      // TU% — a burst costs 40% of the TU pool
            shots:      3,         // rounds fired per shot action
        ),
    ),
    stable: true,             // `stable` tag — braced-by-design (engages the §1a brace bonus unconditionally)
)
