// Stamped slug-thrower — crude lead at close range. The everyman's gun, with
// nothing to recommend it but reliability. Tap a single, rattle a burst, or just
// hold the trigger and let the whole magazine go full-auto.
(
    base_spread:   0.10,
    accuracy:      1.0,
    kickback:      0.05,
    fatal_bias:    0.0,
    damage:        12,
    punch:         5,
    shred:         2,
    damage_type:   Kinetic,
    magazine: (
        size:      12,
        reload_tu: 12,
    ),
    fire_mode: [
        (kind: Single, cone_mult: 1.0, tu_percent: 0.30, shots: 1),
        (kind: Burst,  cone_mult: 1.3, tu_percent: 0.50, shots: 3),
        (kind: Full,   cone_mult: 1.7, tu_percent: 0.60, shots: 6),
    ],
    stable: false,
)
