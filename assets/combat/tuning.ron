// GDTF combat tuning — data-driven balance coefficients (resolution.md §"Coefficients
// live in the combat-tuning data"). Every value here is TUNABLE and hot-swappable: the
// equation FORMS live in code, these numbers are balance data. Each leaf is a
// `#[serde(transparent)]` newtype, so it is written as a bare scalar. Each line says what
// it tunes — edit freely; the sim reads its tuning from this data, never from constants.
(
    // Projectile clearance bands — LEVEL-FRACTIONS (dimensionless, a fraction of one
    // level's height; z in [0,1) within a storey) ABOVE the crossed cell's level floor.
    // As the shot marches, each cell it crosses is banded LOW / MID / HIGH by the round's
    // within-level fraction against these two edges, and the round only sails over an
    // occupant whose band is strictly lower (resolution.md §2). Fractions of a level, so
    // they re-scale with the cubic voxel and carry NO pixel (battle-space.md §"Banding").
    projectile_band_edges: (
        low_mid:  0.33,   // below this fraction of a level = LOW, at/above = MID  (LOW→MID edge)
        mid_high: 0.67,   // below this fraction of a level = MID, at/above = HIGH (MID→HIGH edge)
    ),
    // Wound-severity score scalars (resolution.md §6), floor-extend form. The score is roughly
    //   j·pen_damage − k·Toughness + part_mod + fatal_bias + I·Luck_shooter + roll(−L·Luck_defender .. R).
    // The defender's Luck extends the roll's FLOOR down (a shrug-off chance); the ceiling stays R,
    // so a genuinely bad roll is always still possible (no R_eff/R_min). Bigger pushes → worse
    // wounds more often; the score is bucketed by the edges below into None/Minor/Major/Critical/Fatal.
    severity_scaling: (
        pen_damage_scale:     1.0,   // j — how hard PENETRATING damage pushes severity up
        toughness_mitigation: 1.0,   // k — how much the defender's Toughness subtracts
        shooter_luck_scale:   1.0,   // I — how much the shooter's Luck adds (nastier wounds)
        defender_luck_scale:  1.0,   // L — how far the defender's Luck extends the roll's floor below 0
        random_spread:        10.0,  // R — the fixed ceiling (upper bound) of the random roll
        // The ascending bucket edges on the score: < e0 graze (None), then Minor/Major/Critical,
        // and ≥ e3 is Fatal. Must climb e0 < e1 < e2 < e3 for the buckets to be monotone.
        edges: (
            e0: 1.0,    // None→Minor  — below this is a graze (HP loss only, no Wound)
            e1: 5.0,    // Minor→Major — at/above e1 the wound costs 2 Wounds
            e2: 10.0,   // Major→Critical
            e3: 15.0,   // Critical→Fatal — at/above e3 the hit empties the Wounds pool (death)
        ),
    ),
    // Per-tier Wounds-budget cost (wounds-and-roster.md §"Severity tiers"): how many
    // Wounds (the life pool) each wound spends. The 1/2/3 split is a STARTING POINT
    // ("could be 1/2/4, 1/3/5, …" — tunable). None costs 0 and Fatal EMPTIES the pool —
    // those two are STRUCTURAL (apply_hit branches them), so they are NOT listed here.
    wound_costs: (
        minor:    1,  // Minor wound — flesh wound, cheapest spend (starting point: 1)
        major:    2,  // Major wound — benched until healed (starting point: 2)
        critical: 3,  // Critical wound — maims AND pushes toward death faster (starting point: 3)
    ),
    // Bleed-out clock (resolution.md §9; wounds-and-roster.md §"Downed → death …"): the flat
    // number of Wounds (the life pool) each un-stabilized DOWNED ganger loses every full round
    // it stays down (tick_bleed) — the stack count = turns down = total Wounds lost, a clock you
    // can read. Wounds hitting 0 = Dead via the same terminal gate. A STARTING POINT (tunable);
    // the TU economy it sits inside (when the tick fires, execute/stabilize TU costs) is E4.
    bleed_rate: 1,  // Wounds drained per round each un-stabilized Downed ganger stays down

    // Downed-act TU costs (resolution.md §9): the flat Time Units the two from-Downed
    // verbs cost. `stabilize_downed` (an 8-adjacent ALIVE ally) halts the bleed clock;
    // `execute_downed` (an 8-adjacent ALIVE enemy) finishes a Downed ganger outright.
    // STARTING POINTS (tunable). NOTE: this slice only READS these costs to wire the
    // leaf — the TU economy that DEBITS a Tu pool / checks can-afford is E4, not here.
    stabilize_tu: 4,  // TU an adjacent ally spends to stabilize a Downed ganger (read-only; debit is E4)
    execute_tu:   6,  // TU an adjacent enemy spends to execute a Downed ganger (read-only; debit is E4)

    // Posture / orientation TU costs (combat.md L34: "kneel" + "turn" cost TUs; resolution.md
    // §"What's tunable"): the Time Units the E4.1 posture verbs spend. `set_stance` charges
    // stance_change_tu and `set_facing` charges turn_tu PER 45deg STEP — but ONLY when the
    // stance/facing actually changes (re-asserting the value a ganger already holds is a no-op,
    // no charge). `set_facing` is a PARTIAL turn: it charges turn_tu for each whole 45deg step it
    // can afford and lands partway when the pool runs out (0 affordable steps = no turn, no charge).
    // Toggling the AIM flag (`set_aiming`) is NOT here: the aim cost is the fire-time ×1.5 premium
    // (aim_mode.tu_premium), not a per-toggle charge. STARTING POINTS (tunable).
    stance_change_tu: 8,  // TU a ganger spends to change posture (stand/kneel/prone), charged on a real change
    turn_tu:          1,  // TU a ganger spends PER 45deg step when turning in place (partial turn, charged per afforded step)

    // Per-terrain move cost (combat.md L34: "step" costs TUs): the flat Time Units a ganger
    // spends to step ONTO a destination cell — TERRAIN-DETERMINED (the floor tile crossed
    // determines the cost), looked up by the entered cell's TerrainKind (advance_walk reads
    // grid.terrain(entered) then this table). Coarse per-TerrainKind (Open/Cover/Wall), NOT
    // per-floor-TYPE — richer per-floor-type costs need a richer sim terrain model (a follow-up).
    // The cost is applied FLAT regardless of step direction (a diagonal-costs-more differential is
    // deferred). STARTING POINTS (tunable, flagged — the user gave a facing cost but NOT per-terrain
    // move costs); the verb gates affordability + charges the looked-up cost.
    move_costs: (
        open:  4,  // step onto Open floor — the cheapest baseline (a wall/standing-cover cell blocks, never a dest)
        cover: 6,  // step onto a Cover cell — dearer; reachable only once the cover is DESTROYED (then it no longer blocks)
        wall:  8,  // step onto a Wall — placeholder; a wall always blocks, so this is never charged (dead under the gate)
    ),
    // Per-link traversal cost (E7 · GTW-12a; visibility.md §48: a crossing prices link_tu
    // INSTEAD OF terrain): the flat Time Units a step spends when it is a vertical-link hop
    // (stair / ladder) between levels — advance_walk charges THIS at a link hop instead of
    // the entered terrain's move_cost. ONE flat cost for every link kind (no per-kind
    // stair/ladder split — OQ-6's per-kind variant would need a docs change first).
    // Consumed later by GTW-351 (vertical-link traversal); this leaf only ADDS the tunable.
    // STARTING POINT (tunable, flagged — matched to the cheapest move-cost baseline).
    link_tu: 4,  // TU a ganger spends to cross one vertical link (stair/ladder hop); flat, all kinds

    // Hit-location weights — the RELATIVE odds each body part is the one struck on a hit
    // (resolution.md §4 `roll_body_part`). Larger = struck more often; they need not sum to
    // any total — only the ratios between them matter.
    body_part_weights: (
        head:      6,   // head  — rare, but where the worst wounds land
        torso:     40,  // torso — the bulk of hits
        left_arm:  12,  // left arm
        right_arm: 12,  // right arm
        left_leg:  15,  // left leg
        right_leg: 15,  // right leg
    ),
    // Cone / stability / recoil / aim coefficients (resolution.md §1) — the data the
    // dispersion-cone math reads. WEAPON numbers (base_spread / accuracy / kickback /
    // fatal_bias / magazine_size; per-mode cone-mult / TU% / shots) live on the WEAPON
    // data, never here; everything below is a universal tuning COEFFICIENT.
    cone_stability: (
        // How many points each stance adds to the 0..100 stability score (steadier =
        // more = a narrower cone via the cone-mult curve). resolution.md §1a.
        stance_stability: (
            prone: 40.0,  // prone — steadiest
            kneel: 25.0,  // kneeling — middle
            stand: 10.0,  // standing — least steady
        ),
        // Points added when the faced cell's cover suits the stance (automatic brace).
        brace_contribution: 30.0,  // +30 to the stability score when braced (resolution.md §1a)
        // The minimum faced-cover band each stance needs for its brace to engage:
        // prone braces on LOW+, kneeling on MID+, standing on HIGH (resolution.md §1a).
        brace_min_height: (
            prone: Low,   // prone braces on LOW cover or taller
            kneel: Mid,   // kneeling braces on MID cover or taller
            stand: High,  // standing braces only on HIGH cover
        ),
        // The two curves read off the single 0..100 stability score (resolution.md §1a):
        // cone_mult (steadier -> smaller multiplier -> narrower cone) and recoil_growth
        // (steadier -> less muzzle climb). Authored as ordered (score, output) sample
        // points; the interpolation FORM lives in code. Shape is tunable.
        stability_curves: (
            cone_mult: [
                ( score: 0.0,   output: 1.0 ),   // shaky -> full-width cone
                ( score: 100.0, output: 0.5 ),   // rock-steady -> half-width cone
            ],
            recoil_growth: [
                ( score: 0.0,   output: 1.0 ),    // shaky -> full recoil climb
                ( score: 100.0, output: 0.25 ),   // rock-steady -> little climb
            ],
        ),
        // Aim Mode (a separate axis from the selector): aiming narrows the cone and
        // costs more TU; hip-firing is the ×1 baseline (resolution.md §1a).
        aim_mode: (
            cone_mult:  0.6,   // aimed shots multiply the cone by 0.6 (hip-fired = 1)
            tu_premium: 1.5,   // aimed shots cost ×1.5 TU
        ),
        // Recoil climb: round i's central axis tilts up by prior_shots × recoil_climb ×
        // recoil_growth radians (resolution.md §1a). This is the per-prior-shot rate.
        recoil_climb: 0.01,  // radians of upward tilt per prior shot, before the curve damps it
        // The concentration exponent p = concentration_p(Shooting, weapon.accuracy) of the
        // in-cone draw (resolution.md §1b): higher -> shots cluster nearer dead-center.
        concentration: (
            base:  1.0,   // p at zero accuracy (≈1 scatters evenly to the cone edge)
            scale: 1.0,   // how fast p rises with Shooting × weapon.accuracy
        ),
        // Aim point z = the target's silhouette-top level-fraction × this fraction
        // (resolution.md §1; battle-space.md). Dimensionless level-fraction, NO pixel.
        aim_height_frac: 1.0,  // fraction of the target's silhouette-top height aimed at
        // The barrel offset, de-pxed: a fraction of ONE CELL forward along the facing
        // (clamped so it never leaves the cell). battle-space.md §"Sub-cell precision".
        muzzle_forward_offset: 0.3,  // cell-fraction forward offset of the muzzle along the facing
        // Per-stance muzzle height (the de-pxed shot_z_by_stance): a LEVEL-FRACTION of the
        // shot's launch z, authored to land in design-sensible clearance bands — prone fires
        // LOW (can't clear even LOW cover), kneeling MID, standing HIGH (battle-space.md).
        // Universal tuning, NOT per-ganger data (there is no per-ganger size model).
        muzzle_heights: (
            prone: 0.15,  // prone muzzle — low (lands in the LOW band)
            kneel: 0.45,  // kneeling muzzle — mid (lands in the MID band)
            stand: 0.8,   // standing muzzle — high (lands in the HIGH band)
        ),
        // Per-stance silhouette top (the aim-point source): a LEVEL-FRACTION of the
        // ganger's silhouette top per stance. MOVED here from ganger data this ticket —
        // universal tuning, NOT per-ganger data (battle-space.md datum table).
        silhouette_tops: (
            prone: 0.3,   // prone silhouette top — lowest profile
            kneel: 0.6,   // kneeling silhouette top — compressed
            stand: 0.95,  // standing silhouette top — full height
        ),
    ),
    // 7-type matchup multipliers (matchup.md §"Modifier never auto-win"). The wheel
    // result (favorable / neutral / resisted) multiplies weapon PUNCH and SHRED only —
    // never damage / floor / protection / integrity / hardness (resolution.md §5). A
    // multiplier so it's scale-independent: always felt, never an auto-win. The resisted
    // penalty (−66%) is deliberately DOUBLE the favorable bonus (+33%) — avoid bad
    // matchups, don't just chase good ones. Magnitudes are tunable (ordering is fixed).
    matchup_multipliers: (
        favorable: 1.33,  // weapon type beats armor type — punch & shred ×1.33 (+33%)
        neutral:   1.0,   // same wheel node / mirror — punch & shred unchanged (×1)
        resisted:  0.34,  // weapon type loses to armor type — punch & shred ×0.34 (−66%)
    ),
    // Firing arc (GTW-242): the FULL angular width (DEGREES) of the facing cone a shooter
    // may fire within. A target within ±firing_arc/2 of the facing fires directly; a target
    // OUTSIDE the arc requires the shooter to first turn to face it (paying turn_tu per 45°
    // step) AND afford the shot — else the shot is REJECTED (no spend, no turn, no shot).
    // Continuous-angle test (NOT 8-way snapping). GLOBAL — one arc for every weapon this
    // slice (a per-weapon arc, pistol wide / rifle narrow, is a flagged future refinement).
    // STARTING POINT (tunable): 120° = ±60° off the facing.
    firing_arc: 120.0,  // full firing-cone width in degrees (target must be within ±60° to fire without turning)

    // Squad fog-of-war view range (GTW-338; visibility.md §"Tunables"): one ganger's
    // sight radius in CHEBYSHEV CELLS — the 2D disc bounds per-ganger FOV; the level-aware
    // LOS probe owns the height axis (a ganger sees a cell iff Chebyshev(F,cell) <= this
    // AND has_los). The shipped 60×60 city gets a real fog horizon (the disc is smaller
    // than the map); the 12×12 fixtures read fully lit (the range exceeds the whole map).
    // STARTING POINT (tunable).
    view_range: 14,  // sight radius in Chebyshev cells (60×60 = fog horizon, 12×12 = fully lit)

    // EXPLORED-memory dim factor (GTW-338; visibility.md §"Tunables"): the modulate the
    // presenter fog writer (GTW-342) applies to EXPLORED terrain — rendered RGB × this,
    // ALPHA UNTOUCHED. Memory shows live terrain dimmed, never a snapshot. A value in
    // 0..=1: dark enough to read "memory, not live sight", bright enough to navigate by.
    // STARTING POINT (tunable).
    explored_dim: 0.55,  // EXPLORED terrain RGB modulate (alpha untouched); 0..=1
)
