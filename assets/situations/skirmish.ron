// GDTF authored situation — "skirmish": a small, valid battlefield the setup pours
// into the battle ECS (GTW-205 / E10.3). This is AUTHORED CONTENT (a generated /
// hand-built battlefield), not balance tuning: gangers, cover, slabs, and the
// stair/ladder vertical links that are the only way a ganger changes storey. It
// loads as a loose `.ron` through the RonAsset<Situation> loader, exactly like the
// theme. Render-free, pixel-free: positions are (cell, level) keys (x/y cells, a
// storey index), never pixels. Each line says what it authors — edit freely.
//
// GTW-396 migration: walls/scatter/slabs now reference terrain PIECE NAMES resolved
// against the TerrainRegistry at setup (behavior-preserving — the piece files carry
// the same stats the old inline fields held). The `default_floor` names the walkable
// floor piece for all open cells (deck_floor, move_cost 4).
//
// GTW-384 (the two-layer stat model): each ganger now authors the EIGHT DIRECT
// ATTRIBUTES (the raw potential) — NOT the computed stats. Shooting / HP / Wounds / TU
// (and the dormant Fight / Reactions / Morale / Bottle) are DERIVED at setup from these
// attributes × the assets/combat/stat_tuning.ron weights (the single source of truth,
// docs/combat/stats.md). Attribute magnitudes here are per-ganger DATA (a generated
// roster), authored so the derived stats land near a playable range — not pinned tuning.
(
    // The authored gangers — two gangs (faction 0 and faction 1) facing off. Each
    // carries its full identity/posture + its EIGHT attributes + an armor KEY (resolved
    // against the ArmorRegistry into the battle-local worn armor at setup, GTW-269) + a
    // weapon KEY. Magnitudes here are per-ganger DATA, not pinned tuning.
    gangers: [
        // --- Gang 0: a standing rifleman on the ground floor, facing east. ---
        (
            at:         (cell: (x: 5, y: 6), level: 0),  // (cell, level) it spawns at — its Position
            name:       "Alex Mercer",  // display name — the status panel's identity line shows this
            faction:    0,            // gang identity — gang 0 (one of the two sides)
            facing:     East,         // which of the 8 grid directions it faces
            stance:     Standing,     // posture — upright (full silhouette, full stability gate)
            aiming:     false,        // aim-mode flag — hip-firing, not aimed
            life_state: Alive,        // terminal life state — up and fighting
            speed:      3.0,          // Speed attribute — quickness; drives the derived TU budget (→ ~60 TU)
            aim:        3.0,          // Aim attribute — marksmanship; the dominant derived Shooting term
            strength:   4.0,          // Strength attribute — physical power; a derived Fight term
            toughness:  12.0,         // Toughness attribute — damage resistance; a derived HP term + severity mitigation
            reflexes:   3.0,          // Reflexes attribute — reaction speed; a derived Shooting + Reactions term
            cool:       6.0,          // Cool attribute — nerves; feeds derived Shooting/Fight/Reactions/HP/Morale
            grit:       19.0,         // Grit attribute — resilience; the dominant derived HP + Morale term (→ HP ~34)
            luck:       1.0,          // Luck attribute — directional fortune; the severity-roll tail (not a computed stat)
            armor:      "flak_vest",  // armor KEY — resolves to assets/armor/flak_vest.armor.ron at setup (pieces authored there, GTW-269)
            weapon:     "stub_pistol", // weapon KEY — resolves to assets/weapons/stub_pistol.weapon.ron at setup
        ),
        // --- Gang 1: a crouching, aimed defender across the floor, facing west. ---
        (
            at:         (cell: (x: 12, y: 9), level: 0),  // (cell, level) it spawns at
            name:       "Vex 1",  // display name — the status panel's identity line shows this
            faction:    1,            // gang identity — gang 1 (the opposing side)
            facing:     West,         // faces back toward gang 0
            stance:     Crouching,    // posture — kneeling (compressed silhouette, steadier)
            aiming:     true,         // aim-mode flag — aimed shot (narrows the cone at a TU premium)
            life_state: Alive,        // terminal life state — up and fighting
            speed:      3.0,          // Speed attribute — quickness (→ ~58-60 TU)
            aim:        4.0,          // Aim attribute — a sharper shot than gang 0 (higher derived Shooting)
            strength:   3.0,          // Strength attribute — a derived Fight term
            toughness:  13.0,         // Toughness attribute — slightly hardier (a derived HP term + severity mitigation)
            reflexes:   3.0,          // Reflexes attribute — reaction speed
            cool:       6.0,          // Cool attribute — nerves under fire
            grit:       18.0,         // Grit attribute — resilience (→ HP ~36)
            luck:       2.0,          // Luck attribute — luckier than gang 0 (severity-roll tail)
            armor:      "carapace_plate", // armor KEY — resolves to assets/armor/carapace_plate.armor.ron at setup (pieces authored there, GTW-269)
            weapon:     "las_carbine", // weapon KEY — resolves to assets/weapons/las_carbine.weapon.ron at setup
        ),
        // --- Gang 1: a second crouching, aimed defender, facing west. ---
        (
            at:         (cell: (x: 12, y: 12), level: 0),  // (cell, level) it spawns at
            name:       "Vex 2",  // display name — the status panel's identity line shows this
            faction:    1,            // gang identity — gang 1 (the opposing side)
            facing:     West,         // faces back toward gang 0
            stance:     Crouching,    // posture — kneeling (compressed silhouette, steadier)
            aiming:     true,         // aim-mode flag — aimed shot (narrows the cone at a TU premium)
            life_state: Alive,        // terminal life state — up and fighting
            speed:      3.0,          // Speed attribute — quickness (→ ~58-60 TU)
            aim:        4.0,          // Aim attribute — a sharper shot (higher derived Shooting)
            strength:   3.0,          // Strength attribute — a derived Fight term
            toughness:  13.0,         // Toughness attribute — hardy (a derived HP term + severity mitigation)
            reflexes:   3.0,          // Reflexes attribute — reaction speed
            cool:       6.0,          // Cool attribute — nerves under fire
            grit:       18.0,         // Grit attribute — resilience (→ HP ~36)
            luck:       2.0,          // Luck attribute — luckier than gang 0 (severity-roll tail)
            armor:      "carapace_plate", // armor KEY — resolves to assets/armor/carapace_plate.armor.ron at setup (pieces authored there, GTW-269)
            weapon:     "las_carbine", // weapon KEY — resolves to assets/weapons/las_carbine.weapon.ron at setup
        ),
    ],
    // The authored walls — solid fixed geometry on the ground floor. Each is a
    // CoverSpawn: (cell, level) + a terrain PIECE KEY resolved against the
    // TerrainRegistry at setup (GTW-396 migration: stats live in the piece .ron file).
    walls: [
        (
            at:    (cell: (x: 8, y: 7), level: 0),  // the wall's (cell, level)
            piece: "heavy_bulkhead",                  // terrain piece KEY — resolves to assets/terrain/heavy_bulkhead.terrain.ron
        ),
    ],
    // The authored scatter / props — the SAME schema as a wall (piece key, at).
    scatter: [
        (
            at:    (cell: (x: 9, y: 8), level: 0),  // the prop's (cell, level)
            piece: "barricade",                       // terrain piece KEY — resolves to assets/terrain/barricade.terrain.ron
        ),
    ],
    // The authored floor / roof slabs — each a (cell, level) + a terrain PIECE KEY
    // resolved against the TerrainRegistry at setup (GTW-396 migration: slab HP/armor
    // now live in the piece .ron file, not in tuning.ron slab_defaults).
    // Two stacked slabs at the same cell on adjacent storeys give the vertical link
    // below two non-dangling endpoints to connect (it is the only way to change storey).
    slabs: [
        (at: (cell: (x: 2, y: 2), level: 0), piece: "deck_slab"),  // ground-floor slab — the stair's lower endpoint
        (at: (cell: (x: 2, y: 2), level: 1), piece: "deck_slab"),  // first-floor slab — the stair's upper endpoint (arrival)
        // GTW-387: a small walkable first-floor platform east+south of the stair head, so a
        // ganger who climbs the stair HAS reachable L1 destinations to move to (the bug was
        // that ONLY the link tile existed on L1 — a dead-end). default_floor (deck_floor,
        // move_cost 4) gives each open platform cell its walk cost; no `floors` override needed.
        (at: (cell: (x: 3, y: 2), level: 1), piece: "deck_slab"),  // L1 platform — one cell east of the stair head
        (at: (cell: (x: 4, y: 2), level: 1), piece: "deck_slab"),  // L1 platform — two cells east
        (at: (cell: (x: 3, y: 3), level: 1), piece: "deck_slab"),  // L1 platform — diagonally SE (keeps the platform 2-wide, not a 1-line corridor)
        (at: (cell: (x: 2, y: 3), level: 1), piece: "deck_slab"),  // L1 platform — one cell south of the stair head
    ],
    // The authored stair / ladder vertical links — the ONLY way a ganger changes
    // storey. Each: two (cell, level) endpoints + a kind. Both endpoints below are
    // authored slabs (non-dangling) on DIFFERENT storeys (cross-storey), so the link
    // validates and the file drives the real setup path.
    vertical_links: [
        (
            from: (cell: (x: 2, y: 2), level: 0),       // departure endpoint — the ground-floor slab
            to:   (cell: (x: 2, y: 2), level: 1),       // arrival endpoint — the first-floor slab
            kind: Stair(one_way: false),                 // a normal, bidirectional staircase
        ),
    ],
    // The default floor terrain piece for all walkable open cells — resolved against
    // the TerrainRegistry. move_cost must be >= 4 (the A* heuristic admissibility
    // floor; setup rejects any floor piece below this minimum).
    default_floor: "deck_floor",                         // piece KEY — resolves to assets/terrain/deck_floor.terrain.ron (move_cost 4)
    // Sparse per-cell floor overrides — cells with a non-default floor piece. Empty
    // for this situation (all open cells use the default deck_floor cost).
    floors: [],  // empty = no per-cell overrides; all open cells cost deck_floor move_cost (4 TU)
)
